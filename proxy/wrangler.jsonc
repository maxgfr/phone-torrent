{
  // The optional CORS proxy, deployed from this folder:
  //
  //   cd proxy && wrangler deploy
  //
  // With this file, wrangler knows the Worker's name for `wrangler secret put`
  // too, and has the compatibility date it refuses to deploy without.
  "name": "phone-torrent-proxy",
  "main": "cloudflare-worker.js",
  "compatibility_date": "2026-01-01"
}
