{
  // Run the server on Cloudflare's network, not on a machine of yours (Docker
  // must run where you deploy from: the image is built there):
  //
  //   cd cloudflare && npm install && npx wrangler secret put AUTH_TOKEN && npx wrangler deploy
  //
  // Read cloudflare/README.md first: Containers need a Workers paid plan, the
  // disk is ephemeral, and a container with no inbound port reaches fewer peers
  // than a machine at home. It is the quickest remote start, not a seedbox.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "phone-torrent",
  "main": "worker.js",
  "compatibility_date": "2026-01-01",
  "compatibility_flags": ["nodejs_compat"],

  "containers": [
    {
      "class_name": "TorrentContainer",
      // Built from this repository's Dockerfile; wrangler pushes it for you.
      "image": "../server/Dockerfile",
      "image_build_context": "..",
      "instance_type": "standard-1",
      "max_instances": 1
    }
  ],

  // The container is driven by a Durable Object, which is what keeps it alive
  // between requests and gives it a stable identity.
  "durable_objects": {
    "bindings": [{ "class_name": "TorrentContainer", "name": "TORRENT" }]
  },

  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["TorrentContainer"] }],

  "vars": {
    // Any website may call it, because the token is required: AUTH_TOKEN is a
    // secret, not a var (wrangler secret put AUTH_TOKEN), and until it is set
    // the Worker refuses to start the server.
    "ALLOWED_ORIGINS": "*"
  }
}
