{
  "id": "./",
  "name": "Swarmdeck",
  "short_name": "Swarmdeck",
  "description": "Download, share and edit torrents in your browser, on a phone or a computer, and save the files to your device.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#0b1220",
  "theme_color": "#2563eb",
  "categories": ["utilities", "productivity"],
  "icons": [
    { "src": "./icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "./icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "./icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "./icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ],
  "share_target": {
    "action": "./share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        { "name": "torrents", "accept": [".torrent", "application/x-bittorrent"] }
      ]
    }
  },
  "file_handlers": [
    { "action": "./", "accept": { "application/x-bittorrent": [".torrent"] }, "launch_type": "single-client" }
  ],
  "protocol_handlers": [
    { "protocol": "magnet", "url": "./?magnet=%s" }
  ]
}
